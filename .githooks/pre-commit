#!/bin/sh
# Bloquea el commit si algún cambio añade una clave de Anthropic (el repositorio es público).
# Se activa una vez por clon: git config core.hooksPath .githooks   (la misma comprobación: SecretScanTests)
prefix='sk''-ant-'
if git diff --cached -U0 --no-color | grep '^+' | grep -q -- "$prefix"; then
    echo "pre-commit: hay una clave de Anthropic ($prefix...) en los cambios preparados. Quítala y revócala." >&2
    git diff --cached --name-only -G "$prefix" | sed 's/^/  - /' >&2
    exit 1
fi
